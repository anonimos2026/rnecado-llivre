{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/vibration", "permanent": false }
  ],
  "rewrites": [
    { "source": "/vibration", "destination": "/Mercado Livre/index.html" },
    { "source": "/vibration/", "destination": "/Mercado Livre/index.html" },
    { "source": "/vibration/css/:path*", "destination": "/Mercado Livre/css/:path*" },
    { "source": "/vibration/js/:path*", "destination": "/Mercado Livre/js/:path*" },
    { "source": "/vibration/images/:path*", "destination": "/Mercado Livre/images/:path*" },
    { "source": "/vibration/fonts/:path*", "destination": "/Mercado Livre/fonts/:path*" },
    { "source": "/css/:path*", "destination": "/Mercado Livre/css/:path*" },
    { "source": "/js/:path*", "destination": "/Mercado Livre/js/:path*" },
    { "source": "/images/:path*", "destination": "/Mercado Livre/images/:path*" },
    { "source": "/fonts/:path*", "destination": "/Mercado Livre/fonts/:path*" },
    { "source": "/:path*", "destination": "/Mercado Livre/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
